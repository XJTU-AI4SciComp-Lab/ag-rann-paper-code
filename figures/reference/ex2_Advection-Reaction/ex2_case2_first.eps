456 456 scale
%AXGBeginBitmap: java.awt.image.BufferedImage
{{
/RawData currentfile /ASCII85Decode filter def
/Data RawData /RunLengthDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 456
  /ImageMatrix [456 0 0 456 0 0]
  /Width 456
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
